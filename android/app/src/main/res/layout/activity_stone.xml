<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/screen_root" android:background="@color/background">
    <Toolbar android:layout_width="match_parent" android:layout_height="56dp" android:id="@+id/toolbar" android:background="@color/background" android:titleTextAppearance="@style/ToolbarTitle" android:contentInsetStart="20dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingTop="4dp">
            <kz.asyltas.android.GemView android:layout_width="match_parent" android:layout_height="150dp" android:id="@+id/detail_gem" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/detail_name" android:textSize="30sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:layout_marginTop="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/detail_category" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_surface" android:padding="20dp" android:layout_marginTop="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/detail_price" android:textSize="26sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="бір тас үшін" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="3dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/detail_properties" android:textSize="16sp" android:textColor="@color/text_primary" android:lineSpacingExtra="14dp" android:layout_marginTop="20dp" />
            </LinearLayout>
            <Button android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/detail_add" android:text="Алқаға қосу" style="@style/ActionButton" android:layout_marginTop="20dp" />
            <Button android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/detail_favorite" android:text="Таңдаулыға қосу" style="@style/SecondaryButton" android:layout_marginTop="10dp" />
            <Button android:layout_width="match_parent" android:layout_height="48dp" android:id="@+id/detail_reviews" android:text="Пікірлерді ашу" style="@style/SecondaryButton" android:layout_marginTop="10dp" />
            <Button android:id="@+id/detail_compare" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Салыстыруға қосу" android:layout_marginTop="10dp" />
            <Button android:id="@+id/detail_compare_open" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Салыстыру тізімін ашу" android:layout_marginTop="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Тас туралы" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_marginTop="24dp" />
            <TextView android:id="@+id/detail_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/text_primary" android:lineSpacingExtra="5dp" android:layout_marginTop="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Күтім" android:textSize="18sp" android:textColor="@color/text_primary" android:layout_marginTop="18dp" />
            <TextView android:id="@+id/detail_care" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="5dp" android:layout_marginTop="8dp" />
            <Button android:id="@+id/detail_share" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Тас туралы бөлісу" android:layout_marginTop="16dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Жеке жазбам" android:textSize="20sp" android:textColor="@color/text_primary" android:layout_marginTop="24dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Тек өз аккаунтыңызға көрінеді. Бос жазбаны сақтау оны жояды." android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="5dp" />
            <EditText android:id="@+id/detail_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="100dp" android:gravity="top" android:background="@drawable/bg_field" android:padding="14dp" android:textSize="15sp" android:textColor="@color/text_primary" android:inputType="textMultiLine|textCapSentences" android:maxLength="1000" android:contentDescription="Жеке жазбам" android:layout_marginTop="10dp" />
            <Button android:id="@+id/detail_note_save" style="@style/ActionButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Жазбаны сақтау" android:layout_marginTop="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Бағалар мен сипаттамалар — оқу мысалы." android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="18dp" />
        </LinearLayout>
    </ScrollView>
    <include android:layout_width="match_parent" android:layout_height="wrap_content" layout="@layout/view_navigation" />
</LinearLayout>