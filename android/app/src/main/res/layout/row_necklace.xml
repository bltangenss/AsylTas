<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_surface" android:descendantFocusability="blocksDescendants">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <kz.asyltas.android.GemView android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/item_gem" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginLeft="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/item_name" android:textSize="17sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:id="@+id/item_details" android:textSize="12sp" android:textColor="@color/text_secondary" android:layout_marginTop="3dp" />
        </LinearLayout>
        <Button android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/item_more" android:text="⋯" style="@style/SecondaryButton" android:contentDescription="Тас әрекеттері" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="" android:id="@+id/item_cost" android:textSize="19sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" android:layout_weight="1" />
        <Button android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/item_minus" android:text="−" style="@style/SecondaryButton" android:contentDescription="Санын азайту" />
        <TextView android:layout_width="36dp" android:layout_height="wrap_content" android:text="" android:id="@+id/item_quantity" android:textSize="16sp" android:textColor="@color/text_primary" android:gravity="center" />
        <Button android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/item_plus" android:text="+" style="@style/SecondaryButton" android:contentDescription="Санын көбейту" />
    </LinearLayout>
</LinearLayout>