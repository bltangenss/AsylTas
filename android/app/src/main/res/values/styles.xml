<?xml version="1.0" encoding="utf-8"?>
<resources>
 <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/green</item>
  <item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item>
  <item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/background</item>
  <item name="android:navigationBarColor">@color/green_dark</item><item name="android:windowBackground">@color/background</item>
  <item name="android:alertDialogTheme">@style/AsylDialog</item><item name="android:colorControlHighlight">#24543D32</item>
 </style>
 <style name="AppTheme" parent="BaseAppTheme"/>
 <style name="AsylDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
  <item name="android:colorAccent">@color/green</item><item name="android:windowBackground">@drawable/bg_dialog</item>
  <item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item>
  <item name="android:buttonBarButtonStyle">@style/DialogButton</item><item name="android:fontFamily">sans</item>
 </style>
 <style name="DialogButton" parent="android:style/Widget.Material.Light.Button.Borderless">
  <item name="android:textAllCaps">false</item><item name="android:textColor">@color/green</item><item name="android:minHeight">48dp</item>
 </style>
 <style name="ToolbarTitle" parent="android:style/TextAppearance.Material.Widget.ActionBar.Title">
  <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">21sp</item><item name="android:textColor">@color/text_primary</item>
 </style>
 <style name="ActionButton" parent="android:style/Widget.Material.Light.Button">
  <item name="android:background">@drawable/bg_primary</item><item name="android:stateListAnimator">@null</item>
  <item name="android:textColor">@android:color/white</item><item name="android:textAllCaps">false</item>
  <item name="android:fontFamily">sans-serif-medium</item><item name="android:textSize">14sp</item>
  <item name="android:minWidth">48dp</item><item name="android:minHeight">48dp</item>
  <item name="android:paddingLeft">12dp</item><item name="android:paddingRight">12dp</item>
 </style>
 <style name="SecondaryButton" parent="ActionButton"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/green</item></style>
 <style name="NavigationButton" parent="ActionButton">
  <item name="android:layout_width">0dp</item><item name="android:layout_height">60dp</item><item name="android:layout_weight">1</item>
  <item name="android:layout_marginLeft">3dp</item><item name="android:layout_marginRight">3dp</item>
  <item name="android:background">@drawable/bg_nav</item><item name="android:textColor">@color/nav_text</item>
  <item name="android:textSize">12sp</item><item name="android:gravity">center</item>
  <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">7dp</item>
  <item name="android:paddingLeft">2dp</item><item name="android:paddingRight">2dp</item><item name="android:drawablePadding">3dp</item>
 </style>
 <style name="NumberInput" parent="android:style/Widget.Material.Light.EditText">
  <item name="android:background">@drawable/bg_field</item><item name="android:textColor">@color/text_primary</item>
  <item name="android:textSize">16sp</item><item name="android:padding">10dp</item><item name="android:gravity">center</item>
  <item name="android:inputType">number</item><item name="android:singleLine">true</item><item name="android:minHeight">48dp</item>
  <item name="android:selectAllOnFocus">true</item>
 </style>
</resources>
